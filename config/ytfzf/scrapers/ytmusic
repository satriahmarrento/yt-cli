# Custom ytfzf scraper: YouTube Music (music.youtube.com)
# Uses the official InnerTube WEB_REMIX search API, so results are music-first
# (songs/albums/artists) instead of general YouTube videos.
# Use with: yt -c ytmusic "query"

scrape_ytmusic() {
	search=$1
	[ "$search" = ":help" ] && print_info "Search YouTube Music with the official InnerTube WEB_REMIX API" && return 100
	output_json_file=$2
	_tmp_json="${session_temp_dir}/ytmusic-search.json"

	printf "%s\n" "Searching YouTube Music: $search"

	_payload=$(jq -n --arg q "$search" '{
		context: {
			client: {
				clientName: "WEB_REMIX",
				clientVersion: "1.20261117.06.00",
				hl: "en",
				gl: "US"
			}
		},
		query: $q
	}')

	curl -s -X POST "https://music.youtube.com/youtubei/v1/search" \
		-H "Content-Type: application/json" \
		-H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36" \
		--compressed \
		--data-raw "$_payload" >"$_tmp_json" || exit "$?"

	jq '
		def entry($id; $title; $sub; $thumb):
			($sub | split(" • ")) as $parts |
			{
				scraper: "ytmusic_search",
				url: "https://music.youtube.com/watch?v=\($id)",
				title: ($title // "Unknown"),
				channel: (
					if $parts[0] == "Song" or $parts[0] == "Video"
					then ($parts[1] // "" | split(" | ")[0])
					else ($parts[0] // "")
					end
				),
				duration: (($sub | capture("(?<d>[0-9]+:[0-9]{2})").d) // "N/A"),
				views: (($sub | capture("(?<v>[0-9.]+[KMB]? (views|plays))").v) // ""),
				date: "",
				description: $sub,
				ID: $id,
				thumbs: ($thumb // "")
			};

		def top_card:
			.. | .musicCardShelfRenderer? | select(. != null) |
			(.onTap.watchEndpoint.videoId
				// .buttons[0].buttonRenderer.navigationEndpoint.watchEndpoint.videoId
				// null) as $id |
			select($id != null) |
			entry(
				$id;
				(.title.runs | map(.text) | join(""));
				(.subtitle.runs | map(.text) | join(""));
				.thumbnail.musicThumbnailRenderer.thumbnail.thumbnails[0].url
			);

		def list_item:
			.. | .musicResponsiveListItemRenderer? | select(. != null) |
			select(.playlistItemData.videoId != null) |
			(.flexColumns | map(.musicResponsiveListItemFlexColumnRenderer.text.runs | map(.text) | join(""))) as $cols |
			entry(
				.playlistItemData.videoId;
				$cols[0];
				($cols[1] // "");
				.thumbnail.musicThumbnailRenderer.thumbnail.thumbnails[0].url
			);

		[top_card, list_item]
		| reduce .[] as $x ([]; if any(.[]; .ID == $x.ID) then . else . + [$x] end)
	' <"$_tmp_json" >>"$output_json_file"
}
