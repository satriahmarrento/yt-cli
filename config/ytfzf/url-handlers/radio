#!/usr/bin/env sh
# Custom ytfzf URL Handler: radio
# Memuat full YouTube Mix (Radio) playlist & mengaktifkan tombol next/prev

IFS='	' read -r ytdl_pref is_audio_only is_detach video_pref audio_pref url_handler_opts

for url in "$@"; do
	video_id=""
	case "$url" in
		*v=*)
			video_id="${url#*v=}"
			video_id="${video_id%%&*}"
			;;
		*youtu.be/*)
			video_id="${url#*youtu.be/}"
			video_id="${video_id%%\?*}"
			;;
	esac

	if [ -n "$video_id" ]; then
		# YouTube Mix playlist parameter
		target_url="https://www.youtube.com/watch?v=${video_id}&list=RD${video_id}"
	else
		target_url="$url"
	fi

	# Opsi MPV untuk streaming audio cepat dan full playlist navigation
	MPV_OPTS="--ytdl-raw-options=yes-playlist= --cache=yes --cache-secs=30 --demuxer-max-bytes=30MiB --demuxer-readahead-secs=15 --demuxer-lavf-o=http_persistent=1,reconnect=1,reconnect_streamed=1,reconnect_delay_max=5 --input-terminal=yes"

	if [ "${is_audio_only:-1}" -eq 1 ]; then
		mpv --no-video --ytdl-format="${ytdl_pref:-251/140/bestaudio/best}" $MPV_OPTS $url_handler_opts "$target_url"
	else
		mpv --ytdl-format="${ytdl_pref:-best}" $MPV_OPTS $url_handler_opts "$target_url"
	fi
done
