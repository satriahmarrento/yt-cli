#!/usr/bin/env sh
# Custom ytfzf URL Handler: radio
# Memuat full YouTube Mix (Radio) playlist & mengaktifkan tombol next/prev

IFS='	' read -r ytdl_pref is_audio_only is_detach video_pref audio_pref url_handler_opts

for url in "$@"; do
	video_id=""
	case "$url" in
		*v=*)
			video_id="${url#*v=}"
			video_id="${video_id%%&*}"
			;;
		*youtu.be/*)
			video_id="${url#*youtu.be/}"
			video_id="${video_id%%\?*}"
			;;
	esac

	if [ -n "$video_id" ]; then
		# YouTube Music results use the YTM radio mix (RDAMVM);
		# regular YouTube results keep the standard RD mix.
		case "$url" in
			*music.youtube.com*) list_id="RDAMVM${video_id}" ;;
			*) list_id="RD${video_id}" ;;
		esac
		target_url="https://www.youtube.com/watch?v=${video_id}&list=${list_id}"
	else
		target_url="$url"
	fi

	# Opsi MPV untuk streaming audio cepat, reconnect, dan full playlist navigation.
	# Cache 60s absorbs short mobile-network stalls; without it the HLS cache
	# stays at a few seconds and every hiccup turns into "Buffering...".
	# Keep reconnect=1 but never reconnect_streamed=1 for HLS (see mpv.conf).
	MPV_OPTS="--ytdl-raw-options=yes-playlist=,playlist-end=20 --no-sub --volume=50 --input-terminal=yes --network-timeout=30 --cache=yes --cache-secs=60 --demuxer-readahead-secs=60 --audio-buffer=1 --no-resume-playback --demuxer-lavf-o=http_persistent=1,reconnect=1,reconnect_delay_max=5"

	if [ "${is_audio_only:-1}" -eq 1 ]; then
		mpv --no-video --ytdl-format="${ytdl_pref:-251/140/bestaudio/best}" $MPV_OPTS $url_handler_opts "$target_url"
	else
		mpv --ytdl-format="${ytdl_pref:-best}" $MPV_OPTS $url_handler_opts "$target_url"
	fi
done
